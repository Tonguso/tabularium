# Tabularium configuration. Copy this file to .env in the home folder and replace every <placeholder>.
# .env is listed in .gitignore and must never be committed. A variable already set in the environment wins.

# ===== Required for one agent =====================================================================

# Your Telegram user id (message @userinfobot to see it). The agents answer this user and refuse everyone else.
OWNER_TELEGRAM_USER_ID=<your-telegram-user-id>

# The coordinator's bot token, from @BotFather. One token per agent; never reuse a token between agents.
TELEGRAM_BOT_TOKEN=<coordinator-bot-token>

# Model access: at least one. Both may be set; routing prefers a configured subscription route and falls back
# to the API. Leave a key blank to disable that provider.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# ===== The rest of the cast (one token each; leave blank for slots you do not run) ================

LIBRARIAN_TELEGRAM_BOT_TOKEN=<librarian-bot-token>
ENGINEER_TELEGRAM_BOT_TOKEN=<engineer-bot-token>
PRIVATE_TELEGRAM_BOT_TOKEN=<private-agent-bot-token>

# ===== Optional ===================================================================================

# Claude subscription route through the Claude Code CLI: run `claude setup-token` and paste the token, or leave
# blank to use the CLI's own sign-in.
CLAUDE_CODE_OAUTH_TOKEN=<optional-claude-code-oauth-token>

# Web search providers, tried in the order set on the dashboard (search_order.json in the home folder).
# Without them, search goes through the model routes that offer it.
TAVILY_API_KEY=<optional-tavily-api-key>
ANYSEARCH_API_KEY=<optional-anysearch-api-key>

# Spoken replies to voice notes.
ELEVENLABS_API_KEY=<optional-elevenlabs-api-key>

# An agent's own mailbox: an AgentMail inbox (console.agentmail.to) and a key bound to that inbox. One per agent;
# an agent without a key has no email tools.
COORDINATOR_AGENTMAIL_API_KEY=<optional-agentmail-inbox-key>

# SEC EDGAR asks every client to identify itself with a name and an e-mail address.
EDGAR_IDENTITY=<Your Name> <you@example.com>

# The librarian's writable knowledge-base folder.
KNOWLEDGE_BASE_DIR=<path-to-your-knowledge-base>\_wiki
